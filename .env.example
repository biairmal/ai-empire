# Copy to .env; the Makefile loads it. Change the tokens for anything beyond local dev.
POSTGRES_USER=empire
POSTGRES_PASSWORD=empire
POSTGRES_DB=empire
POSTGRES_PORT=5433

DATABASE_URL=postgres://empire:empire@localhost:5433/empire?sslmode=disable
EMPIRE_OWNER_TOKEN=dev-owner-token
EMPIRE_WORKER_TOKEN=dev-worker-token

# Control plane
CP_ADDR=:8080
EMPIRE_KNOWLEDGE_DIR=knowledge
EMPIRE_STALE_AFTER=60s

# Worker / CLI
EMPIRE_CP_URL=http://localhost:8080
EMPIRE_WORKER_CAPS=go
EMPIRE_WORKSPACES=workspaces
# claude | fake
EMPIRE_AGENT=claude
EMPIRE_AGENT_MODEL=
